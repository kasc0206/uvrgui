# =============================================================================
# UVR OrbStack / Docker — CUDA 版 (NVIDIA GPU 加速)
# =============================================================================
# 前置条件:
#   1. 安装 OrbStack (推荐): https://orbstack.dev
#      或 Docker Desktop: https://docker.com
#
# 构建:
#   orb build -t uvr:cuda -f Dockerfile.cuda .
#
# 运行:
#   orb run --rm --gpus all -v "$PWD/input:/input" -v "$PWD/output:/output" uvr:cuda process /input/song.mp3 --device cuda --out /output
# =============================================================================

# ─── Stage 1: 安装 CUDA PyTorch ──────────────────────────────────────────────
FROM python:3.10-slim AS builder

WORKDIR /build
COPY requirements.txt .

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --prefix=/install \
        torch --index-url https://download.pytorch.org/whl/cu124 \
    && pip install --no-cache-dir --prefix=/install -r requirements.txt \
    && pip install --no-cache-dir --prefix=/install tqdm

# ─── Stage 2: CUDA 运行时 ────────────────────────────────────────────────────
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS runtime

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    ffmpeg \
    curl \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制已安装的 Python 包
COPY --from=builder /install /usr/local

# 复制项目代码
COPY . .

# 创建非 root 用户
RUN useradd -m -u 1000 uvr \
    && chown -R uvr:uvr /app \
    && mkdir -p /input /output \
    && chown uvr:uvr /input /output
USER uvr

ENTRYPOINT ["python", "uvr_cli.py"]
CMD ["--help"]
