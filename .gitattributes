# 文本文件使用 LF 换行符
* text=auto eol=lf

# Python 源文件
*.py text diff=python

# Markdown 文档
*.md text

# 配置文件
*.json text
*.yaml text
*.yml text
*.toml text
*.cfg text
*.ini text

# Shell 脚本
*.sh text eol=lf

# Dockerfile
Dockerfile text

# Makefile
Makefile text

# 二进制文件
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.mp3 binary
*.flac binary
*.pth binary
*.ckpt binary
*.onnx binary
